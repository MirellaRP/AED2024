#include <iostream>
#include <cmath>
#include <vector>
using namespace std;

template <typename T>
struct NodeBpT {
        NodeBpT* next;
        bool leaf;
        vector<T> llaves;
        vector<NodeBpT*> hijo;

        NodeBpT(bool leafy): next(NULL), leaf(leafy){}
};

template <typename T>
class BpT{
        
        NodeBpT<T>* root;
        int M;
        int k;
        public:

        
        BpT(int m): root(NULL), M(m), k(m-1){}

        bool find(NodeBpT<T>* node, T value){

                if(node==NULL){
                        return false;
                }

                int i=0;

                if(node->leaf==true){
                        for (int i = 0; i < node->llaves.size(); i++)
                        {
                                if(node->llaves[i]==value){
                                        return true;
                                }
                                
                        }
                        return false;
                        
                }
                else{
                        for (int i = 0; i < node->llaves.size(); i++)
                        {
                                if(value<node->llaves[i]){
                                        return find(node->hijo[i],value);
                                }else if (value==node->llaves[i]){
                                        return true;
                                }
                        }
                        if(value>node->llaves[k-1]){
                                return find(node->hijo[k+1],value);
                        }
                       
                        
                }

                return false;

        }

        bool search(T value){
                return find(root, value);
        }





};

int main(){
        BpT<int> bpt(4);
