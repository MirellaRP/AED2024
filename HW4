#include <iostream>
#include <cmath>
#include <vector>
using namespace std;

template <typename T>
struct NodeBpT {
        NodeBpT* next;
        bool leaf;
        vector<T> llaves;
        vector<NodeBpT*> hijo;

        NodeBpT(bool leafy): next(NULL), leaf(leafy){}
};

template <typename T>
class BpT{
        
        NodeBpT<T>* root;
        int M;
        int k;
        public:

        
        BpT(int m): root(NULL), M(m), k(m-1){}

        bool find(NodeBpT<T>* node, T value){

                if(node==NULL){
                        return false;
                }

                int i=0;

                if(node->leaf==true){
                        for (int i = 0; i < node->llaves.size(); i++)
                        {
                                if(node->llaves[i]==value){
                                        return true;
                                }
                                
                        }
                        return false;
                        
                }
                else{
                        for (int i = 0; i < node->llaves.size(); i++)
                        {
                                if(value<node->llaves[i]){
                                        return find(node->hijo[i],value);
                                }else if (value==node->llaves[i]){
                                        return true;
                                }
                        }
                        if(value>node->llaves[k-1]){
                                return find(node->hijo[k+1],value);
                        }
                       
                        
                }

                return false;

        }

        bool search(T value){
                return find(root, value);
        }

    // Función para eliminar un valor del árbol B+
    void remove(NodeBpT<T>* node, T value) {
        if (node->leaf) {
            auto it = find(node->llaves.begin(), node->llaves.end(), value);
            if (it != node->llaves.end()) {
                node->llaves.erase(it);
            }
        } else {
            int idx = 0;
            while (idx < node->llaves.size() && value > node->llaves[idx]) {
                idx++;
            }

            if (node->hijos[idx]->llaves.size() < M / 2) {
  
                if (idx != 0 && node->hijos[idx - 1]->llaves.size() >= M / 2) {
                    borrowFromPrev(node, idx);
                } else if (idx != node->llaves.size() && node->hijos[idx + 1]->llaves.size() >= M / 2) {
                    borrowFromNext(node, idx);
                } else {
                    if (idx == node->llaves.size()) {
                        merge(node, idx - 1);
                    } else {
                        merge(node, idx);
                    }
                }
            }
            remove(node->hijos[idx], value);
        }
    }

    void remove(T value) {
        if (root == nullptr) return;

        remove(root, value);

        if (root->llaves.empty()) {
            NodeBpT<T>* oldRoot = root;
            root = (root->leaf) ? nullptr : root->hijos[0];
            delete oldRoot; 
        }
    }
};
    void borrowFromPrev(NodeBpT<T>* node, int idx) {
        NodeBpT<T>* child = node->hijos[idx];
        NodeBpT<T>* sibling = node->hijos[idx - 1];

        child->llaves.insert(child->llaves.begin(), node->llaves[idx - 1]); 
        node->llaves[idx - 1] = sibling->llaves.back(); 
        sibling->llaves.pop_back(); // esto elimina la ult llave

        if (!child->leaf) {
            child->hijos.insert(child->hijos.begin(), sibling->hijos.back()); 
            sibling->hijos.pop_back(); 
        }
    }
    void borrowFromNext(NodeBpT<T>* node, int idx) {
        NodeBpT<T>* child = node->hijos[idx];
        NodeBpT<T>* sibling = node->hijos[idx + 1];

        child->llaves.push_back(node->llaves[idx]);
        node->llaves[idx] = sibling->llaves[0];
        sibling->llaves.erase(sibling->llaves.begin()); 

        if (!child->leaf) {
            child->hijos.push_back(sibling->hijos[0]);
            sibling->hijos.erase(sibling->hijos.begin());
        }
    }
