#include <iostream>
#include <vector>
using namespace std;

template <typename T>
struct NodeBpT {
    NodeBpT* next;
    bool leaf;
    vector<T> llaves;
    vector<NodeBpT*> hijo;

    NodeBpT(bool leafy) : next(NULL), leaf(leafy) {}
};

template <typename T>
class BpT {
    NodeBpT<T>* root;
    int M;
    int k;

public:
    BpT(int m) : root(NULL), M(m), k(m - 1) {}

    bool find(NodeBpT<T>* node, T value){

        if(node==NULL){
            return false;
        }

        int i=0;

        if(node->leaf==true){
            for (int i = 0; i < node->llaves.size(); i++)
            {
                if(node->llaves[i]==value){
                    return true;
                }

            }
            return false;

        }
        else{
            for (int i = 0; i < node->llaves.size(); i++)
            {
                if(value<node->llaves[i]){
                    return find(node->hijo[i],value);
                }else if (value==node->llaves[i]){
                    return true;
                }
            }
            if(value>node->llaves[k-1]){
                return find(node->hijo[k+1],value);
            }


        }

        return false;

    }

    bool search(T value){
        return find(root, value);
    }

    // insercion
    void insert(T value) {
        if (root == NULL) {
            root = new NodeBpT<T>(true);
            root->llaves.push_back(value);
        } else {
            if (root->llaves.size() == M) {
                NodeBpT<T>* newRoot = new NodeBpT<T>(false);
                newRoot->hijo.push_back(root);
                splitChild(newRoot, 0);
                root = newRoot;
            }
            insertNonFull(root, value);
        }
    }

    void splitChild(NodeBpT<T>* parent, int index) {
        NodeBpT<T>* fullNode = parent->hijo[index];
        NodeBpT<T>* newNode = new NodeBpT<T>(fullNode->leaf);
        int midIndex = M / 2;

        for (int i = midIndex + 1; i < fullNode->llaves.size(); i++) {
            newNode->llaves.push_back(fullNode->llaves[i]);
        }
        fullNode->llaves.resize(midIndex);

        if (!fullNode->leaf) {
            for (int i = midIndex + 1; i < fullNode->hijo.size(); i++) {
                newNode->hijo.push_back(fullNode->hijo[i]);
            }
            fullNode->hijo.resize(midIndex + 1);
        }

        parent->llaves.insert(parent->llaves.begin() + index, fullNode->llaves[midIndex]);
        parent->hijo.insert(parent->hijo.begin() + index + 1, newNode);
    }

    void insertNonFull(NodeBpT<T>* node, T value) {
        if (node->leaf) {
            int i = node->llaves.size() - 1;
            while (i >= 0 && node->llaves[i] > value) {
                i--;
            }
            node->llaves.insert(node->llaves.begin() + i + 1, value);
        } else {
            int i = node->llaves.size() - 1;
            while (i >= 0 && node->llaves[i] > value) {
                i--;
            }
            i++;
            if (node->hijo[i]->llaves.size() == M) {
                splitChild(node, i);
                if (node->llaves[i] < value) {
                    i++;
                }
            }
            insertNonFull(node->hijo[i], value);
        }
    }

